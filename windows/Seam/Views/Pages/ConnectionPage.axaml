<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             xmlns:vm="using:Seam.ViewModels"
             xmlns:views="using:Seam.Views"
             xmlns:net="using:Seam.Net"
             x:Class="Seam.Views.Pages.ConnectionPage"
             x:DataType="vm:MainViewModel">
    <ScrollViewer>
        <StackPanel Margin="28,20,28,110" Spacing="24">
            <Grid ColumnDefinitions="*,340" ColumnSpacing="16" MinHeight="510">
                <Panel>
                    <!-- cyjanowa poświata za grafiką, jak na macOS -->
                    <Border>
                        <Border.Background>
                            <RadialGradientBrush Center="50%,50%" GradientOrigin="50%,50%" RadiusX="50%" RadiusY="50%">
                                <GradientStop Color="#472FC8FF" Offset="0" />
                                <GradientStop Color="#002FC8FF" Offset="1" />
                            </RadialGradientBrush>
                        </Border.Background>
                    </Border>
                    <Image Source="avares://Seam/Assets/hero-connection.png" Stretch="Uniform" Margin="12" VerticalAlignment="Center" />
                </Panel>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="20">
                    <TextBlock Text="Two computers.&#10;One space." FontSize="36" LetterSpacing="-1" LineHeight="43" />
                    <TextBlock Text="{Binding DeskNames}" FontSize="16" Foreground="{DynamicResource MutedText}" TextWrapping="Wrap" />
                    <StackPanel Spacing="16" Margin="0,20,0,0">
                        <Grid ColumnDefinitions="44,*,Auto">
                            <Image Source="avares://Seam/Assets/tile-control.png" Width="34" Height="34" HorizontalAlignment="Left" />
                            <TextBlock Grid.Column="1" Text="Mouse &amp; keyboard" VerticalAlignment="Center" FontSize="15" />
                            <ToggleSwitch Grid.Column="2" Classes="compact" IsChecked="{Binding InputSharingEnabled}" AutomationProperties.Name="Mouse &amp; keyboard" />
                        </Grid>
                        <Grid ColumnDefinitions="44,*,Auto">
                            <Image Source="avares://Seam/Assets/tile-audio.png" Width="34" Height="34" HorizontalAlignment="Left" />
                            <TextBlock Grid.Column="1" Text="Audio from Mac" VerticalAlignment="Center" FontSize="15" />
                            <ToggleSwitch Grid.Column="2" Classes="compact" IsChecked="{Binding AudioEnabled}" AutomationProperties.Name="Audio from Mac" />
                        </Grid>
                        <Grid ColumnDefinitions="44,*,Auto">
                            <Image Source="avares://Seam/Assets/tile-clipboard.png" Width="34" Height="34" HorizontalAlignment="Left" />
                            <TextBlock Grid.Column="1" Text="Shared clipboard" VerticalAlignment="Center" FontSize="15" />
                            <ToggleSwitch Grid.Column="2" Classes="compact" IsChecked="{Binding ClipboardSyncEnabled}" AutomationProperties.Name="Shared clipboard" />
                        </Grid>
                        <Button Click="OpenWindows_OnClick" Background="Transparent" BorderThickness="0" Padding="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <Image Source="avares://Seam/Assets/tile-windows.png" Width="34" Height="34" />
                                <TextBlock Text="Move a window" FontSize="15" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Grid>
            <StackPanel Spacing="12" HorizontalAlignment="Center" IsVisible="{Binding IsConnected}">
                <TextBlock Text="All set. Work as if it were one computer." Foreground="{DynamicResource MutedText}" TextAlignment="Center" TextWrapping="Wrap" />
            </StackPanel>
            <Expander x:Name="ConnectionDetails" Header="Pairing and connection details" IsExpanded="{Binding !IsConnected, Mode=OneWay}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
            <StackPanel Spacing="16">

            <Border Classes="card onboarding" IsVisible="{Binding !HasCompletedOnboarding}">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                    <Border Width="44" Height="44" CornerRadius="12" Background="{DynamicResource AccentGradient}">
                        <ui:FontIcon Glyph="&#xE8D4;" FontFamily="{StaticResource IconFont}"
                                     Foreground="White" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="8">
                        <TextBlock Text="Connect your desk in three steps" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Classes="subtitle" Text="1. Open the app on your Mac.  2. Enter the pairing code below.  3. Select the discovered Mac and connect." />
                        <Button Content="Got it" Command="{Binding CompleteOnboardingCommand}"
                                HorizontalAlignment="Left" Classes="accent" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Classes="card">
                <StackPanel Spacing="12">
                    <StackPanel Classes="sectionHeader">
                        <TextBlock Classes="icon" Text="&#xE72E;" />
                        <TextBlock Text="SECURE PAIRING" />
                    </StackPanel>

                    <StackPanel Spacing="8" IsVisible="{Binding !HasPairingKey}">
                        <TextBlock Classes="subtitle"
                                   Text="Enter the code shown on the Mac Connection page. The code is not stored in ordinary settings." />
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                            <TextBox Grid.Column="0" Text="{Binding PairingCode}"
                                     Watermark="XXXXX-XXXXX-XXXXX-XXXXX-XXXXX-X"
                                     MaxLength="31"
                                     FontFamily="Cascadia Mono, Consolas, monospace" />
                            <Button Grid.Column="1" Content="Save code" Classes="accent"
                                    Command="{Binding SavePairingCodeCommand}" />
                        </Grid>
                        <TextBlock Text="{Binding PairingStatusText}" Classes="subtitle"
                                   Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                   IsVisible="{Binding PairingCodeInvalid}" />
                    </StackPanel>

                    <views:SettingRow Title="This PC is paired"
                                      Subtitle="{Binding PairingStatusText}"
                                      IsVisible="{Binding HasPairingKey}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Border Classes="pill">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Ellipse Width="8" Height="8" Fill="{StaticResource StatusGreen}" />
                                    <TextBlock Text="Protected" FontWeight="Medium" />
                                </StackPanel>
                            </Border>
                            <Button Content="Forget" Command="{Binding ForgetPairingCommand}" />
                        </StackPanel>
                    </views:SettingRow>
                </StackPanel>
            </Border>

            <Border Classes="card">
                <StackPanel Spacing="12">
                    <StackPanel Classes="sectionHeader">
                        <TextBlock Classes="icon" Text="&#xE839;" />
                        <TextBlock Text="MACS ON YOUR LOCAL NETWORK" />
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <TextBlock Classes="subtitle" Text="Seam must be running on the Mac. Select it below." />
                        <ListBox ItemsSource="{Binding DiscoveredPeers}"
                                 SelectedItem="{Binding SelectedPeer}"
                                 MaxHeight="140" CornerRadius="8">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="net:DiscoveredPeer">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="{Binding Name}" FontWeight="Medium" />
                                        <TextBlock Text="{Binding Address}" Foreground="{DynamicResource MutedText}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock Classes="subtitle" Text="No Mac found yet — enter its address manually below."
                                   IsVisible="{Binding !HasDiscoveredPeers}" />
                    </StackPanel>

                    <Rectangle Classes="divider" />

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <TextBox Grid.Column="0" Text="{Binding HostAddress}" Watermark="Mac IP address, e.g. 192.168.1.20"
                                 IsEnabled="{Binding !IsConnected}" />
                        <Button Grid.Column="1" Classes="accent" MinWidth="110"
                                Content="{Binding ConnectButtonText}"
                                IsEnabled="{Binding HasPairingKey}"
                                Command="{Binding ToggleConnectCommand}" />
                    </Grid>

                    <views:SettingRow Title="Connect automatically" Subtitle="Reconnect at startup and after a connection loss.">
                        <ToggleSwitch Classes="compact" IsChecked="{Binding AutoConnect}" />
                    </views:SettingRow>
                </StackPanel>
            </Border>

            <Border Classes="card">
                <StackPanel Spacing="12">
                    <StackPanel Classes="sectionHeader">
                        <TextBlock Classes="icon" Text="&#xE946;" />
                        <TextBlock Text="STATUS" />
                    </StackPanel>
                    <views:SettingRow Title="{Binding ConnectionInfo}" Subtitle="{Binding MacStatusText}">
                        <Border Classes="pill">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Ellipse Width="8" Height="8" Fill="{Binding StatusBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding StatusText}" FontWeight="Medium" FontSize="13" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </views:SettingRow>
                    <Rectangle Classes="divider" />
                    <views:SettingRow Title="Pointer" Subtitle="{Binding EmergencyHotkeyDescription}">
                        <TextBlock Text="{Binding CursorStatusText}" FontWeight="Medium" Foreground="{Binding CursorStatusBrush}" />
                    </views:SettingRow>
                </StackPanel>
            </Border>
            </StackPanel>
            </Expander>
        </StackPanel>
    </ScrollViewer>
</UserControl>
