<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Seam.ViewModels"
        x:Class="Seam.Views.ConnectionStatusWindow"
        x:DataType="vm:MainViewModel"
        Width="126" Height="126" CanResize="False"
        SystemDecorations="None" ShowInTaskbar="False" ShowActivated="False"
        Background="Transparent" TransparencyLevelHint="Transparent"
        Title="Connection status">
    <Window.Styles>
        <Style Selector="Button.statusOrb">
            <Setter Property="Width" Value="98" />
            <Setter Property="Height" Value="98" />
            <Setter Property="CornerRadius" Value="49" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="BorderBrush" Value="#B5CED0C7" />
            <Setter Property="Background">
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="80%,100%">
                    <GradientStop Color="#666970" Offset="0" />
                    <GradientStop Color="#2D3035" Offset="0.5" />
                    <GradientStop Color="#17191D" Offset="1" />
                </LinearGradientBrush>
            </Setter>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="49">
                                <StackPanel Spacing="5" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Image Source="avares://Seam/Assets/icon-connection.png" Width="28" Height="28" />
            <TextBlock Text="{Binding OrbStatusText}" FontFamily="Segoe UI, Helvetica Neue, Arial" FontSize="11"
                       FontWeight="Medium" Foreground="White" HorizontalAlignment="Center" />
            <Ellipse Width="5" Height="5" Fill="{Binding StatusBrush}" HorizontalAlignment="Center" />
        </StackPanel>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Button.statusOrb.online">
            <Setter Property="Background"><LinearGradientBrush StartPoint="0%,0%" EndPoint="80%,100%">
                <GradientStop Color="#687E65" Offset="0" /><GradientStop Color="#28312B" Offset="0.5" /><GradientStop Color="#131615" Offset="1" />
            </LinearGradientBrush></Setter>
        </Style>
        <Style Selector="Button.statusOrb.connecting">
            <Setter Property="Background"><LinearGradientBrush StartPoint="0%,0%" EndPoint="80%,100%">
                <GradientStop Color="#947851" Offset="0" /><GradientStop Color="#393126" Offset="0.5" /><GradientStop Color="#1D1914" Offset="1" />
            </LinearGradientBrush></Setter>
        </Style>
        <Style Selector="Button.statusOrb:pointerover"><Setter Property="BorderBrush" Value="White" /></Style>
        <Style Selector="Button.statusOrb:pressed"><Setter Property="Opacity" Value="0.8" /></Style>
        <Style Selector="Button.statusOrb:focus-visible"><Setter Property="BorderBrush" Value="White" /><Setter Property="BorderThickness" Value="3" /></Style>
    </Window.Styles>
    <Button Classes="statusOrb" Classes.online="{Binding IsConnected}" Classes.connecting="{Binding IsConnecting}" Click="ShowDetails_OnClick" AutomationProperties.Name="{Binding StatusText}"
            ToolTip.Tip="{Binding StatusText}" HorizontalAlignment="Center" VerticalAlignment="Center">

    </Button>
</Window>
