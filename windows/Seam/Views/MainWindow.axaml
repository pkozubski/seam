<wnd:AppWindow xmlns="https://github.com/avaloniaui"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:wnd="using:FluentAvalonia.UI.Windowing"
               xmlns:ui="using:FluentAvalonia.UI.Controls"
               xmlns:vm="using:Seam.ViewModels"
               xmlns:pages="using:Seam.Views.Pages"
               xmlns:views="using:Seam.Views"
               x:Class="Seam.Views.MainWindow"
               x:DataType="vm:MainViewModel"
               FontFamily="Segoe UI, Helvetica Neue, Arial"
               Title="seam"
               Icon="avares://Seam/Assets/icon.png"
               Width="1180" Height="800"
               MinWidth="980" MinHeight="680"
               WindowStartupLocation="CenterScreen">

    <Grid RowDefinitions="32,*">
        <!-- Jedno tło pod paskiem tytułu, paskiem bocznym i treścią, bez osobnych pasów; zielone tylko na zakładce Okna -->
        <views:SeamBackdrop x:Name="Backdrop" Grid.RowSpan="2" />

        <!-- Pasek tytułu (obszar przeciągania okna): nazwa strony na środku; logo jest w pasku bocznym -->
        <TextBlock x:Name="PageTitle" FontSize="12.5" FontWeight="SemiBold" Foreground="#E6FFFFFF"
                   HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" />

        <!-- Pasek boczny (WinUI 3 NavigationView), jak na macOS: logo z nazwą, sekcje Funkcje i System,
             na dole Ustawienia, a pod nimi stopka z tym komputerem. Zaznaczenie w szklanej pigułce. -->
        <ui:NavigationView x:Name="Nav" Grid.Row="1"
                           PaneDisplayMode="Left"
                           OpenPaneLength="220"
                           IsPaneOpen="True"
                           IsPaneToggleButtonVisible="False"
                           IsBackButtonVisible="False"
                           IsSettingsVisible="False"
                           RenderOptions.BitmapInterpolationMode="HighQuality"
                           SelectionChanged="Nav_OnSelectionChanged">

            <ui:NavigationView.PaneHeader>
                <StackPanel Orientation="Horizontal" Spacing="10" Margin="16,0,0,16">
                    <Image Source="avares://Seam/Assets/logo.png" Width="46" Height="46"
                           RenderOptions.BitmapInterpolationMode="HighQuality" />
                    <TextBlock Text="seam" FontSize="25" FontWeight="Medium" Foreground="#A3FFFFFF"
                               VerticalAlignment="Center" Margin="0,0,0,3" />
                </StackPanel>
            </ui:NavigationView.PaneHeader>

            <ui:NavigationView.MenuItems>
                <ui:NavigationViewItem Content="Połączenie" Tag="connection" />
                <ui:NavigationViewItem Content="Ekrany" Tag="displays" />
                <ui:NavigationViewItemHeader Content="Funkcje" />
                <ui:NavigationViewItem Content="Klawiatura i mysz" Tag="control" />
                <ui:NavigationViewItem Content="Dźwięk" Tag="audio" />
                <ui:NavigationViewItem Content="Schowek" Tag="clipboard" />
                <ui:NavigationViewItem Content="Okna" Tag="windows" />
                <ui:NavigationViewItemHeader Content="System" />
                <ui:NavigationViewItem Content="Dziennik" Tag="log" />
            </ui:NavigationView.MenuItems>

            <ui:NavigationView.FooterMenuItems>
                <!-- dolny margines robi miejsce na stopkę z tym komputerem (PaneFooter byłby nad Ustawieniami) -->
                <ui:NavigationViewItem Content="Ustawienia" Tag="settings" Margin="0,0,0,104" />
            </ui:NavigationView.FooterMenuItems>

            <Grid RowDefinitions="Auto,Auto,*">
                <!-- Komunikaty globalne – widoczne na każdej stronie -->
                <ui:InfoBar Grid.Row="0" Margin="24,8,24,0"
                            IsOpen="{Binding UpdateAvailable}"
                            Severity="Informational"
                            Title="Dostępna aktualizacja"
                            Message="{Binding UpdateMessage}"
                            IsClosable="True">
                    <ui:InfoBar.ActionButton>
                        <Button Content="Zainstaluj i uruchom ponownie" Command="{Binding InstallUpdateCommand}" />
                    </ui:InfoBar.ActionButton>
                </ui:InfoBar>
                <ui:InfoBar Grid.Row="1" Margin="24,8,24,0"
                            IsOpen="{Binding MacAccessibilityMissing}"
                            Severity="Warning"
                            Title="Mac nie ma uprawnienia Dostępność"
                            Message="Sterowanie nie zadziała, dopóki na Macu nie nadasz Seam uprawnienia w Ustawieniach systemowych (Prywatność i ochrona, sekcja Dostępność)."
                            IsClosable="False" />

                <ContentControl Grid.Row="2" x:Name="PageHost" />
            </Grid>
        </ui:NavigationView>

        <!-- Stopka paska bocznego pod Ustawieniami, jak na macOS: ten komputer, sieć lokalna, wersja -->
        <StackPanel Grid.Row="1" Width="220" Margin="0,0,0,16" Spacing="7"
                    HorizontalAlignment="Left" VerticalAlignment="Bottom">
            <Rectangle Height="1" Fill="#1FFFFFFF" Margin="20,0,20,5" />
            <StackPanel Orientation="Horizontal" Spacing="9" Margin="20,0">
                <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE7F8;" FontSize="15"
                           Foreground="#D9FFFFFF" VerticalAlignment="Center" />
                <TextBlock Text="{Binding DeviceName}" FontSize="13.5" FontWeight="SemiBold"
                           Foreground="#E6FFFFFF" TextTrimming="CharacterEllipsis" MaxWidth="150" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="9" Margin="20,0">
                <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE72E;" FontSize="12"
                           Foreground="#80FFFFFF" VerticalAlignment="Center" Margin="2,0,1,0" />
                <TextBlock Text="Tylko w sieci lokalnej" FontSize="12" Foreground="#99FFFFFF" />
            </StackPanel>
            <TextBlock x:Name="VersionText" FontSize="11.5" Foreground="#61FFFFFF" Margin="20,0" />
        </StackPanel>

        <!-- Separator paska bocznego: znika w tle u góry i u dołu, jak w CleanMyMac -->
        <Rectangle Grid.RowSpan="2" Width="1" HorizontalAlignment="Left" Margin="220,0,0,0" IsHitTestVisible="False">
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                    <GradientStop Color="#00FFFFFF" Offset="0.04" />
                    <GradientStop Color="#2EFFFFFF" Offset="0.3" />
                    <GradientStop Color="#2EFFFFFF" Offset="0.7" />
                    <GradientStop Color="#00FFFFFF" Offset="0.96" />
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>
    </Grid>
</wnd:AppWindow>
