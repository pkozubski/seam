<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Seam.ViewModels"
             x:Class="Seam.Views.ProGateCard"
             x:DataType="vm:MainViewModel"
             IsVisible="{Binding !SessionPro}">
    <!-- Karta pod głównym przełącznikiem funkcji Pro, gdy ani ten PC, ani Mac nie ma Pro (jak ProGateCard na Macu). -->
    <Border Classes="card">
        <StackPanel Spacing="10">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <Border Classes="proBadge"><TextBlock Text="PRO" /></Border>
                <TextBlock Text="{Binding ProGateTitle}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock Classes="subtitle" FontSize="13" Text="{Binding ProGateMessage}" />
            <WrapPanel ItemSpacing="10" LineSpacing="8">
                <Button Classes="accent" Content="Check now" Command="{Binding CheckLicenseCommand}"
                        IsVisible="{Binding ProGateNeedsCheck}" IsEnabled="{Binding !IsLicenseBusy}" />
                <Button Classes="accent" Content="{Binding StartTrialLabel}" Command="{Binding StartTrialCommand}"
                        IsVisible="{Binding CanStartTrial}" />
                <Button Content="{Binding BuyProLabel}" Command="{Binding BuyProCommand}" IsVisible="{Binding CanStartTrial}" />
                <Button Classes="accent" Content="{Binding BuyProLabel}" Command="{Binding BuyProCommand}" IsVisible="{Binding ProGateCanBuyOnly}" />
                <Button Classes="link" Content="Enter license key" Click="OpenLicense" />
            </WrapPanel>
        </StackPanel>
    </Border>
</UserControl>
