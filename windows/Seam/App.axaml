<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sty="using:FluentAvalonia.Styling"
             xmlns:loc="using:Seam.Localization"
             x:Class="Seam.App"
             RequestedThemeVariant="Dark">
    <Application.Styles>
        <!-- Fluent Design v2 / WinUI 3 (FluentAvalonia); szałwiowy akcent jak na macOS zamiast systemowego -->
        <sty:FluentAvaloniaTheme PreferSystemTheme="False" PreferUserAccentColor="False" CustomAccentColor="#91AD8C" />
        <StyleInclude Source="avares://Seam/Styles/Theme.axaml" />
    </Application.Styles>

    <TrayIcon.Icons>
        <TrayIcons>
            <TrayIcon Icon="avares://Seam/Assets/icon.png"
                      ToolTipText="Seam"
                      Clicked="TrayIcon_OnClicked">
                <TrayIcon.Menu>
                    <NativeMenu>
                        <NativeMenuItem Header="{x:Static loc:L10n.ShowWindow}" Click="ShowWindow_OnClick" />
                        <NativeMenuItemSeparator />
                        <NativeMenuItem Header="{x:Static loc:L10n.Quit}" Click="Exit_OnClick" />
                    </NativeMenu>
                </TrayIcon.Menu>
            </TrayIcon>
        </TrayIcons>
    </TrayIcon.Icons>
</Application>
