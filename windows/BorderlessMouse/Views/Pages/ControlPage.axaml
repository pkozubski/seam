<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             xmlns:vm="using:BorderlessMouse.ViewModels"
             xmlns:views="using:BorderlessMouse.Views"
             x:Class="BorderlessMouse.Views.Pages.ControlPage"
             x:DataType="vm:MainViewModel">
    <ScrollViewer>
        <StackPanel Classes="page">
            <StackPanel Spacing="4">
                <TextBlock Classes="pageTitle" x:Name="SectionTitle" Text="Klawiatura i mysz" />
                <TextBlock Classes="pageSubtitle" x:Name="SectionSubtitle" Text="Jedna klawiatura i mysz dla obu komputerów." />
            </StackPanel>

            <!-- KLAWIATURA I MYSZ -->
            <StackPanel x:Name="InputSection" Spacing="14">
                <Border Classes="card hero">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                        <views:IconTile Icon="icon-control" TileSize="44" IsActive="{Binding InputSharingEnabled}" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                            <TextBlock Classes="heroTitle" Text="Udostępniaj klawiaturę i mysz" />
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <Ellipse Width="8" Height="8" Fill="{Binding CursorStatusBrush}" VerticalAlignment="Center" />
                                <TextBlock Classes="subtitle" Text="{Binding CursorStatusText}" VerticalAlignment="Center" />
                            </StackPanel>
                        </StackPanel>
                        <ToggleSwitch Grid.Column="2" Classes="compact" IsChecked="{Binding InputSharingEnabled}" VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <Border Classes="card">
                    <StackPanel Spacing="12">
                        <StackPanel Classes="sectionHeader"><TextBlock Text="KLAWIATURA" /></StackPanel>
                        <views:SettingRow Title="Skrót awaryjny" Subtitle="{Binding EmergencyHotkeyDescription}">
                            <ComboBox ItemsSource="{Binding EmergencyHotkeys}" SelectedItem="{Binding SelectedEmergencyHotkey}" MinWidth="170" />
                        </views:SettingRow>
                    </StackPanel>
                </Border>

                <Border Classes="card">
                    <StackPanel Spacing="12">
                        <StackPanel Classes="sectionHeader"><TextBlock Text="MYSZ" /></StackPanel>
                        <views:SettingRow Title="Czułość myszy na Macu" Subtitle="{Binding RemoteMouseSpeedLabel}">
                            <Slider Minimum="0.25" Maximum="4" TickFrequency="0.25" IsSnapToTickEnabled="True"
                                    Value="{Binding RemoteMouseSpeed}" Width="210" />
                        </views:SettingRow>
                        <Rectangle Classes="divider" />
                        <views:SettingRow Title="Ukrywaj kursor podczas sterowania Makiem"
                                          Subtitle="Kursor zostaje przy krawędzi, przez którą wyszedł, i znika pod niewidocznym oknem.">
                            <ToggleSwitch Classes="compact" IsChecked="{Binding HideCursorWhileRemote}" />
                        </views:SettingRow>
                    </StackPanel>
                </Border>

                <Border Classes="card">
                    <views:SettingRow Title="Położenie Maca" Subtitle="Krawędź, przez którą kursor przechodzi na Maca, ustawiasz w zakładce Ekrany.">
                        <Button Content="Otwórz Ekrany" Click="OpenDisplays" />
                    </views:SettingRow>
                </Border>
                <TextBlock Classes="note" Text="Zamianę klawiszy Ctrl i Cmd oraz przewijanie ustawiasz w aplikacji na Macu." />
            </StackPanel>


            <!-- DŹWIĘK -->
            <StackPanel x:Name="AudioSection" Spacing="14">
                <Border Classes="card hero">
                    <StackPanel Spacing="14">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                            <views:IconTile Icon="icon-audio" TileSize="44" IsActive="{Binding AudioEnabled}" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                                <TextBlock Classes="heroTitle" Text="Odbieraj dźwięk z Maca" />
                                <StackPanel Orientation="Horizontal" Spacing="7">
                                    <Ellipse Width="8" Height="8" Fill="{Binding AudioStatusBrush}" VerticalAlignment="Center" />
                                    <TextBlock Classes="subtitle" Text="{Binding AudioStatusText}" VerticalAlignment="Center" MaxWidth="460" />
                                </StackPanel>
                            </StackPanel>
                            <ToggleSwitch Grid.Column="2" Classes="compact" IsChecked="{Binding AudioEnabled}" VerticalAlignment="Center" />
                        </Grid>
                        <ProgressBar Classes="level" Minimum="0" Maximum="1" Value="{Binding AudioLevel}" IsVisible="{Binding AudioActive}" />
                    </StackPanel>
                </Border>

                <Border Classes="card">
                    <StackPanel Spacing="12">
                        <StackPanel Classes="sectionHeader"><TextBlock Text="ODTWARZANIE" /></StackPanel>
                        <views:SettingRow Title="Urządzenie wyjściowe" Subtitle="Słuchawki lub głośniki podłączone do Windowsa.">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <ComboBox ItemsSource="{Binding AudioDevices}" SelectedItem="{Binding SelectedAudioDevice}" MinWidth="220" MaxWidth="260" />
                                <Button Command="{Binding RefreshAudioDevicesCommand}" ToolTip.Tip="Odśwież listę urządzeń">
                                    <ui:FontIcon Glyph="&#xE72C;" FontFamily="{StaticResource IconFont}" FontSize="14" />
                                </Button>
                            </StackPanel>
                        </views:SettingRow>
                    </StackPanel>
                </Border>

                <Border Classes="card">
                    <StackPanel Spacing="12">
                        <StackPanel Classes="sectionHeader"><TextBlock Text="OPÓŹNIENIE" /></StackPanel>
                        <views:SettingRow Title="Bufor sieciowy" Subtitle="{Binding JitterBufferLabel}">
                            <Slider Minimum="5" Maximum="150" TickFrequency="5" IsSnapToTickEnabled="True"
                                    Value="{Binding JitterBufferMs}" Width="210" />
                        </views:SettingRow>
                        <Rectangle Classes="divider" />
                        <views:SettingRow Title="Tryb WASAPI exclusive"
                                          Subtitle="Najniższe opóźnienie, ale blokuje kartę dla innych aplikacji. Przy braku wsparcia wraca do shared.">
                            <ToggleSwitch Classes="compact" IsChecked="{Binding ExclusiveMode}" />
                        </views:SettingRow>
                    </StackPanel>
                </Border>
                <TextBlock Classes="subtitle mono" Margin="4,0,0,0" Text="{Binding AudioStatsText}"
                           IsVisible="{Binding AudioStatsText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            </StackPanel>

            <!-- SCHOWEK -->
            <StackPanel x:Name="ClipboardSection" Spacing="14">
                <Border Classes="card hero">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                        <views:IconTile Icon="icon-clipboard" TileSize="44" IsActive="{Binding ClipboardSyncEnabled}" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                            <TextBlock Classes="heroTitle" Text="Synchronizuj schowek" />
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <Ellipse Width="8" Height="8" Fill="{Binding StatusBrush}" VerticalAlignment="Center" />
                                <TextBlock Classes="subtitle" Text="{Binding ClipboardStatusText}" VerticalAlignment="Center" MaxWidth="460" />
                            </StackPanel>
                        </StackPanel>
                        <ToggleSwitch Grid.Column="2" Classes="compact" IsChecked="{Binding ClipboardSyncEnabled}" VerticalAlignment="Center" />
                    </Grid>
                </Border>
                <Border Classes="card">
                    <StackPanel Spacing="10">
                        <StackPanel Classes="sectionHeader"><TextBlock Text="CO JEST PRZESYŁANE" /></StackPanel>
                        <WrapPanel ItemSpacing="8" LineSpacing="8">
                            <Border Classes="pill"><TextBlock Text="Tekst" FontSize="12" /></Border>
                            <Border Classes="pill"><TextBlock Text="Zdjęcia i zrzuty ekranu" FontSize="12" /></Border>
                            <Border Classes="pill"><TextBlock Text="Obrazy do 32 MiB" FontSize="12" /></Border>
                        </WrapPanel>
                        <TextBlock Classes="subtitle" Text="W obie strony, tylko w sieci lokalnej, szyfrowane jak całe połączenie." />
                    </StackPanel>
                </Border>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
