<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:BorderlessMouse.ViewModels"
             x:Class="BorderlessMouse.Views.Pages.DisplaysPage"
             x:DataType="vm:MainViewModel">
    <ScrollViewer>
        <StackPanel Classes="page">
            <StackPanel Spacing="4">
                <TextBlock Classes="pageTitle" Text="Ustaw ekrany tak, jak stoją na biurku" />
                <TextBlock Classes="pageSubtitle" Text="Kliknij miejsce obok tego monitora, w którym stoi Mac. Kursor przechodzi na Maca przez tę krawędź." />
            </StackPanel>

            <Border Classes="card">
                <StackPanel Spacing="12">
                    <StackPanel Classes="sectionHeader">
                        <TextBlock Text="UKŁAD EKRANÓW" />
                    </StackPanel>
                    <Border Classes="stage" Padding="24">
                        <Grid ColumnDefinitions="*,Auto,*" RowDefinitions="Auto,Auto,Auto"
                              HorizontalAlignment="Center" ColumnSpacing="6" RowSpacing="6">
                            <Button Grid.Row="0" Grid.Column="1" x:Name="SlotTop" Classes="slot" Width="200" Height="96" HorizontalAlignment="Center" />
                            <Button Grid.Row="1" Grid.Column="0" x:Name="SlotLeft" Classes="slot" Width="200" Height="140" HorizontalAlignment="Right" />
                            <Border Grid.Row="1" Grid.Column="1" Classes="screen" Width="250" Height="150">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="4">
                                    <TextBlock x:Name="ThisPcName" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                    <Border Classes="pill" HorizontalAlignment="Center">
                                        <TextBlock Text="Ten komputer" FontSize="11" />
                                    </Border>
                                </StackPanel>
                            </Border>
                            <Button Grid.Row="1" Grid.Column="2" x:Name="SlotRight" Classes="slot" Width="200" Height="140" HorizontalAlignment="Left" />
                            <Button Grid.Row="2" Grid.Column="1" x:Name="SlotBottom" Classes="slot" Width="200" Height="96" HorizontalAlignment="Center" />
                        </Grid>
                    </Border>
                    <TextBlock Classes="subtitle" HorizontalAlignment="Center"
                               Text="Przy kilku monitorach przejście prowadzi przez ten, który jest najdalej po wybranej stronie." />
                </StackPanel>
            </Border>

            <Border Classes="card">
                <StackPanel Spacing="12">
                    <StackPanel Classes="sectionHeader">
                        <TextBlock Text="PRZEJŚCIE KURSORA" />
                    </StackPanel>
                    <Grid ColumnDefinitions="*,Auto" MinHeight="44">
                        <StackPanel VerticalAlignment="Center" Spacing="2" Margin="0,0,12,0">
                            <TextBlock Classes="rowTitle" x:Name="SideTitle" />
                            <TextBlock Classes="subtitle" Text="{Binding EmergencyHotkeyDescription}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Ellipse Width="8" Height="8" Fill="{Binding CursorStatusBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding CursorStatusText}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
