// Strona seam na Cloudflare Workers: same pliki statyczne z tego katalogu, bez skryptu Workera.
// Deploy: .github/workflows/site.yml (wrangler deploy przy zmianach w site/). Pomijane pliki: .assetsignore.
{
  "$schema": "https://unpkg.com/wrangler@latest/config-schema.json",
  "name": "seam-site",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": ".",
    // /legal/eula → /legal/eula/ (pliki legal/eula/index.html)
    "html_handling": "auto-trailing-slash",
    // nieznany adres → 404.html ze statusem 404
    "not_found_handling": "404-page"
  },
  // Własna domena (strefa seamdesk.app w tym samym koncie Cloudflare); www pokazuje to samo, canonical wskazuje seamdesk.app.
  "routes": [
    { "pattern": "seamdesk.app", "custom_domain": true },
    { "pattern": "www.seamdesk.app", "custom_domain": true }
  ]
}
