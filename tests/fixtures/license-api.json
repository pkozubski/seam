{
  "comment": "Responses of the Seam license server (license-server/, api.seamdesk.app/v1/licenses/…) and how both apps interpret them (macOS LicenseClient.swift, Windows LicenseClient.cs). license-server/test checks that the server produces these shapes. expect.status = resulting license status; expect.error = network | rejected | wrongProduct, with the server's code where it maps to a localized message.",
  "keyPattern": "^SEAM(-[0-9A-HJKMNP-TV-Z]{5}){4}$",
  "cases": [
    { "name": "activate: ok", "call": "activate", "acceptsTest": false, "http": 200,
      "body": { "activated": true, "instance": { "id": "0f4c2a51-7e1b-4f0e-9a4e-3d2b9f1c6a10" }, "license": { "status": "active", "test": false }, "customer_email": "buyer@example.com" },
      "expect": { "status": "active", "instanceId": "0f4c2a51-7e1b-4f0e-9a4e-3d2b9f1c6a10", "email": "buyer@example.com" } },
    { "name": "activate: test license in a release build", "call": "activate", "acceptsTest": false, "http": 200,
      "body": { "activated": true, "instance": { "id": "i-test" }, "license": { "status": "active", "test": true }, "customer_email": "buyer@example.com" },
      "expect": { "error": "wrongProduct" } },
    { "name": "activate: test license in a dev build", "call": "activate", "acceptsTest": true, "http": 200,
      "body": { "activated": true, "instance": { "id": "i-test" }, "license": { "status": "active", "test": true }, "customer_email": "buyer@example.com" },
      "expect": { "status": "active", "instanceId": "i-test", "email": "buyer@example.com" } },
    { "name": "activate: unknown key", "call": "activate", "acceptsTest": false, "http": 404,
      "body": { "activated": false, "code": "invalid_key", "error": "This license key doesn't exist." },
      "expect": { "error": "rejected", "code": "invalid_key" } },
    { "name": "activate: device limit", "call": "activate", "acceptsTest": false, "http": 403,
      "body": { "activated": false, "license": { "status": "active", "test": false }, "code": "device_limit", "error": "This key is already active on 3 computers. Deactivate it on one of them first." },
      "expect": { "error": "rejected", "code": "device_limit" } },
    { "name": "activate: refunded license", "call": "activate", "acceptsTest": false, "http": 403,
      "body": { "activated": false, "license": { "status": "disabled", "test": false }, "code": "license_disabled", "error": "This license has been disabled (refund or chargeback)." },
      "expect": { "error": "rejected", "code": "license_disabled" } },
    { "name": "activate: unexpected code keeps the server message", "call": "activate", "acceptsTest": false, "http": 400,
      "body": { "code": "bad_request", "error": "Send a JSON object." },
      "expect": { "error": "rejected", "code": "bad_request", "message": "Send a JSON object." } },
    { "name": "activate: server error", "call": "activate", "acceptsTest": false, "http": 502,
      "raw": "<html>Bad gateway</html>",
      "expect": { "error": "network" } },
    { "name": "activate: garbage with 200", "call": "activate", "acceptsTest": false, "http": 200,
      "raw": "not json",
      "expect": { "error": "network" } },

    { "name": "validate: ok", "call": "validate", "acceptsTest": false, "http": 200,
      "body": { "valid": true, "license": { "status": "active", "test": false }, "customer_email": "buyer@example.com" },
      "expect": { "status": "active", "email": "buyer@example.com" } },
    { "name": "validate: deactivated on another computer", "call": "validate", "acceptsTest": false, "http": 200,
      "body": { "valid": false, "license": { "status": "active", "test": false }, "customer_email": "buyer@example.com" },
      "expect": { "status": "inactive", "email": "buyer@example.com" } },
    { "name": "validate: refunded", "call": "validate", "acceptsTest": false, "http": 200,
      "body": { "valid": false, "license": { "status": "disabled", "test": false }, "customer_email": "buyer@example.com" },
      "expect": { "status": "disabled", "email": "buyer@example.com" } },
    { "name": "validate: unknown key", "call": "validate", "acceptsTest": false, "http": 404,
      "body": { "valid": false, "license": null, "code": "invalid_key", "error": "This license key doesn't exist." },
      "expect": { "status": "inactive" } },
    { "name": "validate: test license after moving to a release build", "call": "validate", "acceptsTest": false, "http": 200,
      "body": { "valid": true, "license": { "status": "active", "test": true }, "customer_email": "buyer@example.com" },
      "expect": { "status": "inactive", "email": "buyer@example.com" } },
    { "name": "validate: server error", "call": "validate", "acceptsTest": false, "http": 500,
      "body": { "code": "server_error", "error": "Server error." },
      "expect": { "error": "network" } },

    { "name": "deactivate: ok", "call": "deactivate", "acceptsTest": false, "http": 200,
      "body": { "deactivated": true },
      "expect": { "status": "inactive" } },
    { "name": "deactivate: unknown key", "call": "deactivate", "acceptsTest": false, "http": 404,
      "body": { "deactivated": false, "code": "invalid_key", "error": "This license key doesn't exist." },
      "expect": { "error": "rejected", "code": "invalid_key" } }
  ]
}
