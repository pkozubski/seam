{
  "comment": "Shared vectors for the Pro entitlement model (macOS Entitlement.swift, Windows Entitlement.cs). Trial 7 days, license re-validated after 7 days, works offline for 30 days after the last successful validation. Times are UTC.",
  "trialDays": 7,
  "revalidateDays": 7,
  "offlineGraceDays": 30,
  "peerStatusFrameHex": "610101",
  "cases": [
    { "name": "fresh install",
      "now": "2026-11-01T12:00:00Z", "trialStartedAt": null, "license": null,
      "expect": { "state": "free", "entitled": false, "trialDaysLeft": null, "shouldRevalidate": false } },
    { "name": "trial just started",
      "now": "2026-11-01T12:00:00Z", "trialStartedAt": "2026-11-01T12:00:00Z", "license": null,
      "expect": { "state": "trial", "entitled": true, "trialDaysLeft": 7, "shouldRevalidate": false } },
    { "name": "trial day 3, partial day rounds up",
      "now": "2026-11-04T18:00:00Z", "trialStartedAt": "2026-11-01T12:00:00Z", "license": null,
      "expect": { "state": "trial", "entitled": true, "trialDaysLeft": 4, "shouldRevalidate": false } },
    { "name": "last hour of trial",
      "now": "2026-11-08T11:00:00Z", "trialStartedAt": "2026-11-01T12:00:00Z", "license": null,
      "expect": { "state": "trial", "entitled": true, "trialDaysLeft": 1, "shouldRevalidate": false } },
    { "name": "trial ends exactly after 7 days",
      "now": "2026-11-08T12:00:00Z", "trialStartedAt": "2026-11-01T12:00:00Z", "license": null,
      "expect": { "state": "trialExpired", "entitled": false, "trialDaysLeft": null, "shouldRevalidate": false } },
    { "name": "clock moved back more than a day before trial start",
      "now": "2026-10-30T11:00:00Z", "trialStartedAt": "2026-11-01T12:00:00Z", "license": null,
      "expect": { "state": "trialExpired", "entitled": false, "trialDaysLeft": null, "shouldRevalidate": false } },
    { "name": "clock slightly behind trial start (time zone change) still counts",
      "now": "2026-11-01T02:00:00Z", "trialStartedAt": "2026-11-01T12:00:00Z", "license": null,
      "expect": { "state": "trial", "entitled": true, "trialDaysLeft": 7, "shouldRevalidate": false } },
    { "name": "license validated today",
      "now": "2026-11-01T12:00:00Z", "trialStartedAt": null, "license": { "status": "active", "validatedAt": "2026-11-01T10:00:00Z" },
      "expect": { "state": "pro", "entitled": true, "trialDaysLeft": null, "shouldRevalidate": false } },
    { "name": "license due for re-validation after 7 days",
      "now": "2026-11-08T10:00:00Z", "trialStartedAt": null, "license": { "status": "active", "validatedAt": "2026-11-01T10:00:00Z" },
      "expect": { "state": "pro", "entitled": true, "trialDaysLeft": null, "shouldRevalidate": true } },
    { "name": "license offline for 30 days still works",
      "now": "2026-12-01T10:00:00Z", "trialStartedAt": null, "license": { "status": "active", "validatedAt": "2026-11-01T10:00:00Z" },
      "expect": { "state": "pro", "entitled": true, "trialDaysLeft": null, "shouldRevalidate": true } },
    { "name": "license offline for more than 30 days needs validation",
      "now": "2026-12-01T10:00:01Z", "trialStartedAt": null, "license": { "status": "active", "validatedAt": "2026-11-01T10:00:00Z" },
      "expect": { "state": "validationRequired", "entitled": false, "trialDaysLeft": null, "shouldRevalidate": true } },
    { "name": "refunded license is revoked even with trial used",
      "now": "2026-11-20T12:00:00Z", "trialStartedAt": "2026-11-01T12:00:00Z", "license": { "status": "disabled", "validatedAt": "2026-11-20T11:00:00Z" },
      "expect": { "state": "revoked", "entitled": false, "trialDaysLeft": null, "shouldRevalidate": false } },
    { "name": "revoked license does not end a running trial",
      "now": "2026-11-03T12:00:00Z", "trialStartedAt": "2026-11-01T12:00:00Z", "license": { "status": "expired", "validatedAt": "2026-11-03T11:00:00Z" },
      "expect": { "state": "trial", "entitled": true, "trialDaysLeft": 5, "shouldRevalidate": false } },
    { "name": "deactivated license falls back to trial state",
      "now": "2026-11-20T12:00:00Z", "trialStartedAt": "2026-11-01T12:00:00Z", "license": { "status": "inactive", "validatedAt": "2026-11-20T11:00:00Z" },
      "expect": { "state": "trialExpired", "entitled": false, "trialDaysLeft": null, "shouldRevalidate": false } },
    { "name": "license beats an expired trial",
      "now": "2026-11-20T12:00:00Z", "trialStartedAt": "2026-11-01T12:00:00Z", "license": { "status": "active", "validatedAt": "2026-11-19T12:00:00Z" },
      "expect": { "state": "pro", "entitled": true, "trialDaysLeft": null, "shouldRevalidate": false } }
  ]
}
